    },
    {
      "matchFileNames": [
        "infra/**"
      ],
      "matchManagers": [
        "terraform",
        "terragrunt",
        "custom.regex"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ]
    },
    {
      "enabled": false,
