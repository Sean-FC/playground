{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^infra\\/terragrunt\\.common\\.hcl$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?\\s+[A-Za-z0-9_]+\\s*=\\s*\"[^\"\\d]*(?<currentValue>\\d[^\"\\s]*)\"",
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?\\s+source\\s*=\\s*\"git::https:\\/\\/github\\.com\\/[^\"]*?\\?ref=tags\\/(?<currentValue>\\d[^\"\\s]*)\"",
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?\\s+source\\s*=\\s*\"[^\"]+\"\\s+version\\s*=\\s*\"~>\\s*(?<currentValue>\\d[^\"\\s]*)\""
      ]
    }
  ],
  "dependencyDashboard": true,
  "enabledManagers": [
    "helmv3",
    "terraform",
    "terragrunt",
    "custom.regex"
  ],
  "includePaths": [
    "argo/charts/**",
    "infra/**"
  ],
  "lockFileMaintenance": {
    "enabled": true
  },
  "packageRules": [
    {
      "matchFileNames": [
        "argo/charts/**"
      ],
      "matchManagers": [
        "helmv3"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ]
    },
    {
      "groupName": "chart gateway-api",
      "matchFileNames": [
        "argo/charts/_crds/gateway-api/**"
      ],
      "matchManagers": [
        "helmv3"
      ]
    },
    {
      "groupName": "chart presigner",
      "matchFileNames": [
        "argo/charts/apps/presigner/**"
      ],
      "matchManagers": [
        "helmv3"
      ]
    },
    {
      "groupName": "chart amazon-eks-pod-identity-webhook",
      "matchFileNames": [
        "argo/charts/core/amazon-eks-pod-identity-webhook/**"
      ],
      "matchManagers": [
        "helmv3"
      ]
    },
    {
      "groupName": "chart argo",
      "matchFileNames": [
        "argo/charts/core/argo/**"
      ],
      "matchManagers": [
        "helmv3"
      ]
    },
    {
      "groupName": "chart aws-cloud-controller-manager",
      "matchFileNames": [
